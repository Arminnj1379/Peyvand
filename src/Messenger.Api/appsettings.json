{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017?directConnection=true",
    "DatabaseName": "messenger"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "messenger-media",
    "UseSSL": false
  },
  "FileStorage": {
    "Provider": "Minio",
    "RootPath": "data/media"
  },
  "LiveKit": {
    "Url": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Jwt": {
    "Issuer": "messenger",
    "Audience": "messenger",
    "AccessTokenMinutes": 15
  },
  "RateLimit": {
    "AuthPermitLimit": 20,
    "ApiPermitLimit": 600
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "AllowedHosts": "*"
}
